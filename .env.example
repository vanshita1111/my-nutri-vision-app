# ── Copy this to .env and fill in real values ─────────────────────────────────
# cp .env.example .env
# NEVER commit .env to git — it is in .gitignore

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development              # development | production
SECRET_KEY=change-me-use-openssl-rand-hex-32   # generate: openssl rand -hex 32
DEBUG=true
LOG_LEVEL=info

# ── Compute device ────────────────────────────────────────────────────────────
DEVICE=cpu                       # cpu | cuda | mps (Apple Silicon)

# ── Database ──────────────────────────────────────────────────────────────────
# Dev (matches docker-compose.yml defaults):
DATABASE_URL=postgresql+asyncpg://nutrition:nutrition@localhost:5432/nutrition_vision

# Production overrides (set in .env on the server):
POSTGRES_USER=nutrition
POSTGRES_PASSWORD=change-me-strong-password     # generate: openssl rand -hex 24

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Production only (must match docker-compose.prod.yml):
REDIS_PASSWORD=change-me-strong-redis-password  # generate: openssl rand -hex 24

# ── Auth ──────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days
JWT_ALGORITHM=HS256

# ── Anthropic / Claude ────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com → API keys
# NEVER paste your actual key here — put it only in .env
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE
CLAUDE_MODEL=claude-opus-4-6

# ── AWS S3 (leave blank to use local filesystem storage in dev) ───────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=nutrition-vision-images

# ── USDA FoodData Central ─────────────────────────────────────────────────────
# Free API key at https://api.nal.usda.gov/
USDA_API_KEY=

# ── ML model paths ────────────────────────────────────────────────────────────
YOLO_MODEL_PATH=models/weights/food_detector_v1.onnx
SAM2_MODEL_PATH=models/weights/sam2_hiera_large.pt
SAM2_CONFIG=sam2_hiera_l.yaml
DEPTH_MODEL_ID=depth-anything/Depth-Anything-V2-Small-hf   # Small=fast on CPU

# ── Production-only variables ─────────────────────────────────────────────────
IMAGE_TAG=latest                              # Docker image tag for prod deploys
FLOWER_USER=admin                             # Celery dashboard username
FLOWER_PASSWORD=change-me-flower-password     # generate: openssl rand -hex 16
